# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# ---- Docker / production ----
# Public address Caddy serves HTTPS on, e.g. 13-54-10-20.sslip.io or api.example.com
# Use "localhost" when testing on your own machine
DOMAIN=localhost
POSTGRES_DB=taskmanager_db
POSTGRES_USER=taskmanager
# Letters and digits only (it is placed inside a URL)
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>

# ---- App ----
# Local runs without Docker only; docker-compose builds this from the POSTGRES_* values
DATABASE_URL=postgresql://taskmanager:<POSTGRES_PASSWORD>@localhost:5432/taskmanager_db
SECRET_KEY=<SECRET_KEY>
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Leave S3_BUCKET unset to disable uploads locally.
# On EC2 do NOT add AWS keys here - the instance IAM role provides credentials.
AWS_REGION=ap-southeast-2
S3_BUCKET=
MAX_UPLOAD_MB=10
